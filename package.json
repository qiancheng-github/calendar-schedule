{
  "name": "calendar-schedule",
  "version": "1.0.0",
  "description": "日历排班小程序 - 支持农历、节日、多员工排班",
  "scripts": {
    "dev": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:fresh": "node -e \"try{require('fs').rmSync('dist/build/mp-weixin',{recursive:true,force:true})}catch(e){}\" && uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.4.27",
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5000720260410001",
    "pinia": "2.1.7",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "vite": "^5.2.8",
    "typescript": "^5.4.5",
    "vue-tsc": "^2.0.11"
  }
}
